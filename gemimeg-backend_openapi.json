  "paths": {
    "/api/v1/dcc/xsd/dcc/xml": {
      "post": {
        "tags": [
          "CalibrationCertificateController"
        ],
        "description": "Convert a DCC DTO as JSON to XML",
        "operationId": "convertAndValidate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalibrationCertificateDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dcc/xsd/dcc/selfSign": {
      "post": {
        "tags": [
          "CalibrationCertificateController"
        ],
        "description": "Self-signs a CalibrationCertificate (JSON) using SHA-256",
        "operationId": "selfSign",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalibrationCertificateDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalibrationCertificateDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dcc/xsd/dcc/json": {
      "post": {
        "tags": [
          "CalibrationCertificateController"
        ],
        "description": "Convert a valid DCC XML to JSON",
        "operationId": "validateAndConvert",
        "requestBody": {
          "content": {
            "application/xml": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalibrationCertificateDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dcc/xsd/dcc/html": {
      "post": {
        "tags": [
          "CalibrationCertificateController"
        ],
        "description": "Convert a DCC DTO as JSON to a human-readable HTML page",
        "operationId": "validateAndProduceHtml",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalibrationCertificateDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dcc/xsd/dcc/{id}": {
      "get": {
        "tags": [
          "CalibrationCertificateController"
        ],
        "description": "Retrieves a DCC as JSON from the internal storage by its ID.",
        "operationId": "findById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalibrationCertificateDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dcc/xsd/dcc/{id}/xml": {
      "get": {
        "tags": [
          "CalibrationCertificateController"
        ],
        "description": "Retrieves a DCC as XML from the internal storage by its ID.",
        "operationId": "findByIdAsXml",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
