From e14e8566f06eccbaf044fabc2d5e47706598aeb9 Mon Sep 17 00:00:00 2001
From: Mario Attrovio <marioleonardo.attrovio@dentsu.com>
Date: Tue, 3 Feb 2026 00:05:00 +0100
Subject: [PATCH 09/11] first deploy dcc

---
 Dockerfile          |  4 ++--
 nginx.conf          | 33 +++++++++++++++++++++------------
 src/proxy.conf.json |  9 +++++++++
 3 files changed, 32 insertions(+), 14 deletions(-)

diff --git a/Dockerfile b/Dockerfile
index fe84030..f57357f 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -33,9 +33,9 @@ FROM nginx:alpine
 
 # Environment Variables
 ENV NGINX_PORT=80
-ENV BACKEND_HOST=gemimeg-backend
+ENV BACKEND_HOST=172.20.0.129
 ENV BACKEND_PORT=10001
-ENV GATEWAY_HOST=gateway-iam
+ENV GATEWAY_HOST=172.20.0.200
 ENV GATEWAY_PORT=8080
 
 # Copy built application from build stage
diff --git a/nginx.conf b/nginx.conf
index d93e96b..1c8e13d 100644
--- a/nginx.conf
+++ b/nginx.conf
@@ -17,9 +17,9 @@ server {
     return 301 /gemimegdcc/;
   }
 
-  # Auth endpoints - proxy to gateway-iam
+  # Auth endpoints - proxy to gateway-iam (172.20.0.200)
   location /me {
-    proxy_pass http://gateway-iam:8080/me;
+    proxy_pass http://172.20.0.200:8080/me;
     proxy_set_header Host $host;
     proxy_set_header X-Real-IP $remote_addr;
     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
@@ -27,7 +27,7 @@ server {
   }
 
   location /login/ {
-    proxy_pass http://gateway-iam:8080/login/;
+    proxy_pass http://172.20.0.200:8080/login/;
     proxy_set_header Host $host;
     proxy_set_header X-Real-IP $remote_addr;
     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
@@ -35,43 +35,52 @@ server {
   }
 
   location /logout {
-    proxy_pass http://gateway-iam:8080/logout;
+    proxy_pass http://172.20.0.200:8080/logout;
     proxy_set_header Host $host;
     proxy_set_header X-Real-IP $remote_addr;
     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
     proxy_set_header X-Forwarded-Proto $scheme;
   }
 
-  # API endpoints - proxy to gateway-iam
+  # API endpoints - proxy to gateway-iam (172.20.0.200)
   location /API/ {
-    proxy_pass http://gateway-iam:8080/API/;
+    proxy_pass http://172.20.0.200:8080/API/;
     proxy_set_header Host $host;
     proxy_set_header X-Real-IP $remote_addr;
     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
     proxy_set_header X-Forwarded-Proto $scheme;
   }
 
-  # DCC API endpoints - proxy to gemimeg-backend
+  # DCC API endpoints - proxy to gemimeg-backend (172.20.0.129)
   location /api/v1/dcc/ {
-    proxy_pass http://gemimeg-backend:10001/api/v1/dcc/;
+    proxy_pass http://172.20.0.129:10001/api/v1/dcc/;
     proxy_set_header Host $host;
     proxy_set_header X-Real-IP $remote_addr;
     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
     proxy_set_header X-Forwarded-Proto $scheme;
   }
 
-  # Cache API endpoints - proxy to gemimeg-backend
+  # Cache API endpoints - proxy to gemimeg-backend (172.20.0.129)
   location /api/v1/cache/ {
-    proxy_pass http://gemimeg-backend:10001/api/v1/cache/;
+    proxy_pass http://172.20.0.129:10001/api/v1/cache/;
     proxy_set_header Host $host;
     proxy_set_header X-Real-IP $remote_addr;
     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
     proxy_set_header X-Forwarded-Proto $scheme;
   }
 
-  # API docs - proxy to gemimeg-backend
+  # API docs - proxy to gemimeg-backend (172.20.0.129)
   location /v3/api-docs/ {
-    proxy_pass http://gemimeg-backend:10001/v3/api-docs/;
+    proxy_pass http://172.20.0.129:10001/v3/api-docs/;
+    proxy_set_header Host $host;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    proxy_set_header X-Forwarded-Proto $scheme;
+  }
+
+  # DCC service - proxy to dcc-service (172.20.0.14)
+  location /dcc-service/ {
+    proxy_pass http://172.20.0.14:8080/;
     proxy_set_header Host $host;
     proxy_set_header X-Real-IP $remote_addr;
     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
diff --git a/src/proxy.conf.json b/src/proxy.conf.json
index 854cea2..fa72a75 100644
--- a/src/proxy.conf.json
+++ b/src/proxy.conf.json
@@ -40,5 +40,14 @@
     "secure": false,
     "changeOrigin": true,
     "logLevel": "debug"
+  },
+  "/dcc-service/**": {
+    "target": "http://localhost:8080",
+    "secure": false,
+    "changeOrigin": true,
+    "logLevel": "debug",
+    "pathRewrite": {
+      "^/dcc-service": ""
+    }
   }
 }
-- 
2.49.0.windows.1

