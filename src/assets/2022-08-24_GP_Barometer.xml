    <dcc:statements>
      <dcc:statement>
        <dcc:countryCodeISO3166_1>DE</dcc:countryCodeISO3166_1>
        <dcc:norm>DIN 1301-3</dcc:norm>
        <dcc:reference>„Einheiten – Teil 3: Umrechnung von Nicht-SI-Einheiten“ (2018)</dcc:reference>
        <dcc:nonSIDefinition>Millibar</dcc:nonSIDefinition>
        <dcc:nonSIUnit>|mbar</dcc:nonSIUnit>
      </dcc:statement>
      <dcc:statement>
        <dcc:declaration>
          <dcc:content lang="de">Das Kalibriergut zeigt den Luftdruck in der nicht-SI-Einheit Millibar an. Die
            Kalibrierung erfolgt hingegen in der SI-Einheit Pascal.
          </dcc:content>
        </dcc:declaration>
      </dcc:statement>
      <dcc:statement refType="basic_LaboratoryOpinion">
        <dcc:declaration>
          <dcc:name>
            <dcc:content lang="de">Meinung</dcc:content>
            <dcc:content lang="en">Opinion</dcc:content>
          </dcc:name>
          <dcc:content lang="de">Das Kalibriergut gibt die Messwerte nicht in SI-Einheiten an. Eine entsprechende
            Kennzeichnung am Gerät sollte vorgenommen werden.
          </dcc:content>
          <dcc:content lang="en">The calibration item does not specify the measured values in SI units. A corresponding
            marking should be made on the device.
          </dcc:content>
        </dcc:declaration>
      </dcc:statement>
      <dcc:statement>
        <dcc:norm>DIN EN ISO/IEC 17025:2018-03</dcc:norm>
        <dcc:reference>7.8.2.1 l)</dcc:reference>
        <dcc:declaration>
          <dcc:content lang="de">Die Ergebnisse beziehen sich nur auf den in diesem DCC beschriebenen Gegenstand.
          </dcc:content>
          <dcc:content lang="en">The results refer only to the object calibrated in this DCC.</dcc:content>
        </dcc:declaration>
      </dcc:statement>
      <dcc:statement refId="basic_staticPerformanceLocation">
        <dcc:declaration>
