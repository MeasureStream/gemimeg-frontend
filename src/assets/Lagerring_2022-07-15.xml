                  <si:real>
                    <si:value>12</si:value>
                    <si:unit>\one</si:unit>
                  </si:real>
                </dcc:quantity>
                <dcc:quantity>
                  <dcc:name>
                    <dcc:content lang="de">Durchmesser des Kreises zur Bildung der Referenzfläche</dcc:content>
                  </dcc:name>
                  <si:real>
                    <si:value>650</si:value>
                    <si:unit>\milli\metre</si:unit>
                  </si:real>
                </dcc:quantity>
              </dcc:list>
              <dcc:list>
                <dcc:name>
                  <dcc:content lang="de">Ausgezeichnete Gerade auf der Referenzfläche</dcc:content>
                </dcc:name>
                <dcc:description>
                  <dcc:content lang="de">Die Gerade wird bestimmt durch die Achsmitten der zwei auf der Referenzfläche
                    verschraubten zylinderförmigen Inbusschraubenköpfe. Die Achsmitten der Inbusschrauben werden mit je
                    sieben Antastungen gemessen.
                  </dcc:content>
                </dcc:description>
                <dcc:quantity>
                  <dcc:name>
                    <dcc:content lang="de">Anzahl der Antastungen der Inbusschraubenköpfe</dcc:content>
                  </dcc:name>
                  <si:real>
                    <si:value>7</si:value>
                    <si:unit>\one</si:unit>
                  </si:real>
                </dcc:quantity>
              </dcc:list>
              <dcc:list>
                <dcc:name>
                  <dcc:content lang="de">Ausgezeichneter Punkt auf der Referenzfläche</dcc:content>
                </dcc:name>
                <dcc:description>
                  <dcc:content lang="de">Der Ursprung des Bezugssystems wird bestimmt durch den Durchstoßpunkt der Achse
                    durch zwei höhenversetzt gemessene Innenkreismitten mit der Referenzfläche. Die beiden Innenkreise
                    werden mit je sechzehn Antastungen gemessen.
                  </dcc:content>
                </dcc:description>
                <dcc:quantity>
                  <dcc:name>
                    <dcc:content lang="de">Anzahl der Antastungen der Innenkreise.</dcc:content>
                  </dcc:name>
                  <si:real>
                    <si:value>16</si:value>
                    <si:unit>\one</si:unit>
                  </si:real>
                </dcc:quantity>
              </dcc:list>
            </dcc:list>
          </dcc:data>
        </dcc:influenceCondition>
        <dcc:influenceCondition>
          <dcc:name>
            <dcc:content lang="de">Umgebungsbedingungen</dcc:content>
          </dcc:name>
          <dcc:data>
            <dcc:quantity>
              <dcc:name>
                <dcc:content lang="de">Umgebungstemperatur</dcc:content>
              </dcc:name>
              <dcc:description>
                <dcc:content lang="de">Die mittlere Temperatur betrug während der Messungen 19,8 °C.</dcc:content>
              </dcc:description>
              <si:real>
                <si:value>19.8</si:value>
                <si:unit>\degreecelsius</si:unit>
              </si:real>
            </dcc:quantity>
          </dcc:data>
        </dcc:influenceCondition>
        <dcc:influenceCondition>
          <dcc:name>
            <dcc:content lang="de">Lagerung</dcc:content>
          </dcc:name>
          <dcc:description>
            <dcc:content lang="de">Die Lagerung des Rings auf dem KMG erfolgte auf drei fest mit dem Ring verschraubten
              Füßen direkt auf dem Messtisch des KMG, ohne weitere Fixierung.
            </dcc:content>
          </dcc:description>
          <dcc:data>
