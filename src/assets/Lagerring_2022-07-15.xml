                <si:unit>\milli\metre</si:unit>
              </si:real>
            </dcc:measuringEquipmentQuantity>
          </dcc:measuringEquipmentQuantities>
        </dcc:measuringEquipment>
      </dcc:measuringEquipments>
      <dcc:influenceConditions>
        <dcc:influenceCondition>
          <dcc:name>
            <dcc:content lang="de">Objektkoordinatensystem</dcc:content>
          </dcc:name>
          <dcc:description refId="FigItem">
            <dcc:content lang="de">Das Objektkoordinatensystem wurde über die oben liegende Referenzfläche, die
              Achsmitten der zwei auf der Referenzfläche verschraubten zylinderförmigen Inbusschraubenköpfe, sowie der
              Achse durch zwei höhenversetzt gemessene Innenkreismitten definiert.
            </dcc:content>
          </dcc:description>
          <dcc:data>
            <dcc:list>
              <dcc:list>
                <dcc:name>
                  <dcc:content lang="de">Referenzfläche</dcc:content>
                </dcc:name>
                <dcc:description>
                  <dcc:content lang="de">Die Referenzfläche wurde mit zwölf gleichmäßig auf einem definierten
                    Kreisumfang von 650 mm Durchmesser verteilten Antastungen gebildet.
                  </dcc:content>
                </dcc:description>
                <dcc:quantity>
                  <dcc:name>
                    <dcc:content lang="de">Anzahl der Antastungen zur Bildung der Referenzfläche</dcc:content>
