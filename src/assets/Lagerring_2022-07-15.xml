  <dcc:measurementResults>
    <dcc:measurementResult>
      <dcc:name>
        <dcc:content lang="de">Merkmale des Lagerrings</dcc:content>
      </dcc:name>
      <dcc:description>
        <dcc:content lang="de">An dem Lagerring wurden der Durchmesser und die Rundheitsabweichung an zwei Innenkreisen
          im Abstand 15 mm und 100 mm zur Referenzfläche kalibriert.
        </dcc:content>
      </dcc:description>
      <dcc:usedMethods>
        <dcc:usedMethod>
          <dcc:name>
            <dcc:content lang="de">Scan-Modus</dcc:content>
          </dcc:name>
          <dcc:description>
            <dcc:content lang="de">Im Scan-Modus wurde mit den Geschwindigkeiten 2 mm/s und 5 mm/s gemessen. Für jedem
              Kreis-Scan wurden 78905 Messpunkte über einen Mittelpunktswinkel von 0° bis 400° aufgezeichnet. Zudem
              wurden alle Kreise-Scans in zwei weiteren um die Zylinderachse des Rings gedrehten Stellungen gemessen.
              Bezogen auf die Stellung 1 = 0° in den der Stell. 2 = +90° und in Stell. 3 = +45°.
            </dcc:content>
            <dcc:file id="Fig2">
              <dcc:fileName></dcc:fileName>
              <dcc:mimeType></dcc:mimeType>
              <dcc:dataBase64>BildSeite4Abbildung2</dcc:dataBase64>
            </dcc:file>
          </dcc:description>
        </dcc:usedMethod>
        <dcc:usedMethod>
          <dcc:name>
            <dcc:content lang="de">Einzelpunkt-Modus</dcc:content>
          </dcc:name>
          <dcc:description refId="Fig2">
            <dcc:content lang="de">Im Einzelpunkt-Modus wurden 3600 Messpunkte pro Kreismessung über einen
              Mittelpunktswinkel von 0° bis 360° aufgezeichnet. Die Einzelpunkt-Antastungen wurden nur in Stellung 0°
              gemessen.
            </dcc:content>
          </dcc:description>
        </dcc:usedMethod>
        <dcc:usedMethod>
          <dcc:name>
            <dcc:content lang="de">Wiederholungsmessung</dcc:content>
          </dcc:name>
          <dcc:description>
            <dcc:content lang="de">Jede Kreismessung wurde in jeder Stellung fünfmal wiederholt und die Ergebnisse
              gemittelt.
            </dcc:content>
          </dcc:description>
        </dcc:usedMethod>
        <dcc:usedMethod>
          <dcc:name>
            <dcc:content lang="de">Auswertungsmethode</dcc:content>
          </dcc:name>
          <dcc:description>
            <dcc:content lang="de">Die Ausgleichselemente wurden nach der Methode der kleinsten Abstandsquadrate
              „Ausgleichskreis nach Gauss“ berechnet.
            </dcc:content>
          </dcc:description>
        </dcc:usedMethod>
        <dcc:usedMethod>
          <dcc:name>
            <dcc:content lang="de">Korrektur der thermischen Ausdehnung</dcc:content>
          </dcc:name>
          <dcc:description>
            <dcc:content lang="de">Die Ergebnisse wurden auf die Bezugstemperatur mittels eines linearen
              Ausdehnungsmodells korrigiert.
            </dcc:content>
          </dcc:description>
        </dcc:usedMethod>
      </dcc:usedMethods>
      <dcc:measuringEquipments>
        <dcc:measuringEquipment>
          <dcc:name>
            <dcc:content lang="de">Koordinatenmessgerät</dcc:content>
          </dcc:name>
          <dcc:description>
            <dcc:content lang="de">Die Messungen wurden auf einem rückgeführten Koordinatenmessgerät (KMG) vom Typ LEITZ
              Infinity durchgeführt.
            </dcc:content>
          </dcc:description>
          <dcc:model>LEITZ Infinity</dcc:model>
        </dcc:measuringEquipment>
        <dcc:measuringEquipment>
          <dcc:name>
            <dcc:content lang="de">Taster</dcc:content>
          </dcc:name>
          <dcc:description>
            <dcc:content lang="de">Die Messungen wurden mit einem Taster von 114 mm Länge und einem Tastkugeldurchmesser
              von 8 mm durchgeführt.
            </dcc:content>
          </dcc:description>
          <dcc:measuringEquipmentQuantities>
            <dcc:measuringEquipmentQuantity>
              <dcc:name>
                <dcc:content lang="de">Tasterlänge</dcc:content>
              </dcc:name>
              <si:real>
